<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow/bevel bottom -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A2A"/>
            <corners android:radius="4dp"/>
            <size android:width="80dp" android:height="32dp"/>
        </shape>
    </item>
    <!-- Dark track -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#3A3A4A"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <!-- Knob on left side -->
    <item android:left="4dp" android:right="52dp" android:top="4dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#EEEEEE"/>
            <corners android:radius="3dp"/>
            <size android:width="24dp" android:height="22dp"/>
        </shape>
    </item>
</layer-list>
