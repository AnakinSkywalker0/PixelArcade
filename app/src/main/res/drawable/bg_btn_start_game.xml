<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow / 3D Bevel -->
    <item>
        <shape>
            <solid android:color="@color/retro_dark_box_shadow"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <!-- Top Face (Inset from the bottom to show the shadow) -->
    <item android:bottom="6dp">
        <shape>
            <solid android:color="@color/retro_dark_box"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
