<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow -->
    <item>
        <shape>
            <solid android:color="#3D2020"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <!-- Top Face -->
    <item android:bottom="6dp">
        <shape>
            <solid android:color="#FF6B6B"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</layer-list>
