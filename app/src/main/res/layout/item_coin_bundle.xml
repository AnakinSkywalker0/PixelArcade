<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pixel_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivBundleIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_coin"
        app:tint="@color/arcade_yellow" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBundleAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/press_start_2p"
            android:text="500"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBundleBonus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/press_start_2p"
            android:text="+ 0 BONUS"
            android:textColor="@color/arcade_yellow"
            android:textSize="8sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPurchase"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_auth_btn_primary"
        android:fontFamily="@font/press_start_2p"
        android:paddingBottom="4dp"
        android:text="₹99"
        android:textColor="#0A0A0F"
        android:textSize="10sp" />

</LinearLayout>
