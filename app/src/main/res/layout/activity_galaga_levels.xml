<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    tools:context=".GalagaLevelsActivity">

    <!-- Animated Starry Background -->
    <com.example.pixelarcade.StarfieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:textColor="#FFFF00"
                android:textSize="10sp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BACK"
                android:fontFamily="@font/press_start_2p"
                android:textColor="#FFFF00"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SELECT LEVEL"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginEnd="60dp" />
    </LinearLayout>

    <View
        android:id="@+id/vHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222222"
        app:layout_constraintTop_toBottomOf="@id/topBar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vHeaderDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GALAGA"
                android:fontFamily="@font/press_start_2p"
                android:textColor="#555555"
                android:textSize="10sp"
                android:layout_marginTop="16dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVELS"
                android:fontFamily="@font/press_start_2p"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 WAVES PER LEVEL"
                android:fontFamily="@font/press_start_2p"
                android:textColor="#333333"
                android:textSize="10sp"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#222222" />

            <!-- LEVEL 1: SECTOR ALPHA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLevel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#111111"
                app:strokeColor="#222222"
                app:strokeWidth="1dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNum1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:fontFamily="@font/press_start_2p"
                        android:textColor="#00FF7F"
                        android:textSize="32sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvNum1">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SECTOR ALPHA"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES 1 - 3 • RECRUIT"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="8sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLEARED"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#00FF7F"
                            android:textSize="8sp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_box_green_outline" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BEST 18400"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="8sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNum1"
                        app:layout_constraintStart_toStartOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES  "
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="8sp"/>
                        
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#00FF7F" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#00FF7F" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#00FF7F" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#00FF7F" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="#00FF7F" android:textSize="12sp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEVEL 2: NEBULA BELT (LOCKED) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLevel2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0D0D0D"
                app:strokeColor="#1A1A1A"
                app:strokeWidth="1dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.5"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNum2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02"
                        android:fontFamily="@font/press_start_2p"
                        android:textColor="#333333"
                        android:textSize="32sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvNum2">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEBULA BELT"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES 4 - 6 • PILOT"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCKED"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="4dp"
                            android:background="#1A1A1A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNum2"
                        app:layout_constraintStart_toStartOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES  "
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"/>
                        
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEVEL 3: VOID STORM (LOCKED) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLevel3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0D0D0D"
                app:strokeColor="#1A1A1A"
                app:strokeWidth="1dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.5"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNum3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03"
                        android:fontFamily="@font/press_start_2p"
                        android:textColor="#333333"
                        android:textSize="32sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvNum3">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VOID STORM"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES 7 - 9 • ACE"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCKED"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="4dp"
                            android:background="#1A1A1A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNum3"
                        app:layout_constraintStart_toStartOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES  "
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"/>
                        
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEVEL 4: GALAGA CORE (LOCKED) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLevel4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0D0D0D"
                app:strokeColor="#1A1A1A"
                app:strokeWidth="1dp"
                app:cardCornerRadius="8dp"
                android:layout_marginBottom="24dp"
                android:alpha="0.5"
                android:clickable="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNum4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04"
                        android:fontFamily="@font/press_start_2p"
                        android:textColor="#333333"
                        android:textSize="32sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvNum4">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GALAGA CORE"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES 10 - 12 • COMMANDER"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:layout_marginTop="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCKED"
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="4dp"
                            android:background="#1A1A1A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/tvNum4"
                        app:layout_constraintStart_toStartOf="parent">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WAVES  "
                            android:fontFamily="@font/press_start_2p"
                            android:textColor="#333333"
                            android:textSize="8sp"/>
                        
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                        <View android:layout_width="16dp" android:layout_height="2dp" android:background="#222222" android:layout_marginHorizontal="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○" android:textColor="#333333" android:textSize="12sp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OVERALL BEST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#111111"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OVERALL BEST"
                    android:fontFamily="@font/press_start_2p"
                    android:textColor="#777777"
                    android:textSize="10sp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="000000"
                    android:fontFamily="@font/press_start_2p"
                    android:textColor="#FFFF00"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- PLAY LEVEL BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlayLevel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="PLAY LEVEL"
                android:fontFamily="@font/press_start_2p"
                android:textSize="14sp"
                android:textColor="#000000"
                android:backgroundTint="#FFFF00"
                android:layout_marginBottom="16dp"
                android:enabled="false"
                android:alpha="0.3" />

            <!-- MAIN MENU BUTTON -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMainMenu"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="MAIN MENU"
                android:fontFamily="@font/press_start_2p"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A1A1A"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
