<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ═══════════ HEADER BAR ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pixel_card_dark"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Back Button -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@color/arcade_purple"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:fontFamily="@font/press_start_2p"/>

            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SETTINGS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/press_start_2p"
                android:gravity="center"
                android:layout_marginStart="8dp"/>

            <!-- Coin Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/tvSettingsCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1250"
                    android:textColor="@color/arcade_yellow"
                    android:textSize="9sp"
                    android:fontFamily="@font/press_start_2p"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════ CONTENT ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- ─── SOUND SECTION ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOUND"
                    android:textColor="@color/arcade_yellow"
                    android:textSize="12sp"
                    android:fontFamily="@font/press_start_2p"/>
            </LinearLayout>

            <!-- Dotted separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333344"
                android:layout_marginBottom="16dp"/>

            <!-- Volume Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvVolumeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUME"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:fontFamily="@font/press_start_2p"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/btnVolMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_pixel_inner_dark"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/press_start_2p"
                    android:gravity="center"/>

                <SeekBar
                    android:id="@+id/sbVolume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:maxHeight="12dp"
                    android:minHeight="12dp"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/sh_seekbar_progress"
                    android:thumb="@drawable/sh_seekbar_thumb"
                    android:splitTrack="false"/>

                <TextView
                    android:id="@+id/btnVolPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_pixel_inner_dark"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/press_start_2p"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Sound Effects Row -->
            <LinearLayout
                android:id="@+id/rowSoundEffects"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SOUND EFFECTS"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:fontFamily="@font/press_start_2p"/>

                <!-- Toggle container: text + knob visual -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="32dp">
                    <ImageView
                        android:id="@+id/ivSoundEffects"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_toggle_on"/>
                    <TextView
                        android:id="@+id/tvToggleSfx"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="ON"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:fontFamily="@font/press_start_2p"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="3dp"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Music Row -->
            <LinearLayout
                android:id="@+id/rowMusic"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MUSIC"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:fontFamily="@font/press_start_2p"/>

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="32dp">
                    <ImageView
                        android:id="@+id/ivMusic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_toggle_off"/>
                    <TextView
                        android:id="@+id/tvToggleMusic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="OFF"
                        android:textColor="#AAAAAA"
                        android:textSize="8sp"
                        android:fontFamily="@font/press_start_2p"
                        android:gravity="center_vertical|end"
                        android:paddingStart="28dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ─── GAME SECTION ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAME"
                    android:textColor="@color/arcade_yellow"
                    android:textSize="12sp"
                    android:fontFamily="@font/press_start_2p"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333344"
                android:layout_marginBottom="16dp"/>



            <!-- Grid Lines Row -->
            <LinearLayout
                android:id="@+id/rowGridLines"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GRID LINES"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:fontFamily="@font/press_start_2p"/>

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="32dp">
                    <ImageView
                        android:id="@+id/ivGridLines"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_toggle_on"/>
                    <TextView
                        android:id="@+id/tvToggleGrid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="ON"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:fontFamily="@font/press_start_2p"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="28dp"
                        android:paddingBottom="3dp"/>
                </FrameLayout>
            </LinearLayout>



            <!-- ─── ACTION BUTTONS ─── -->

            <!-- Reset Game Data -->
            <LinearLayout
                android:id="@+id/btnResetData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_red"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="18dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗑"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESET GAME DATA"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/press_start_2p"/>
            </LinearLayout>

            <!-- Back to Menu -->
            <LinearLayout
                android:id="@+id/btnBackToMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_gray"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/press_start_2p"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACK TO MENU"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/press_start_2p"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#09090D"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navArcade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕹️"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="ARCADE"
                android:textColor="#666666"
                android:textSize="6sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navChallenges"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="CHALLENGE"
                android:textColor="#666666"
                android:textSize="6sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="SHOP"
                android:textColor="#666666"
                android:textSize="6sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_item_selected">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="SETTING"
                android:textColor="@color/arcade_yellow"
                android:textSize="6sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
