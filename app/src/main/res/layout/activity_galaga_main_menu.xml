<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:fitsSystemWindows="true"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".GalagaMainMenuActivity">

    <!-- Animated Starry Background -->
    <com.example.pixelarcade.StarfieldView
        android:id="@+id/ivBackgroundStars"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Back Button -->
    <LinearLayout
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀"
            android:textColor="#FFFF00"
            android:textSize="10sp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACK"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFF00"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Title GALAGA (Split into characters for different colors) -->
    <LinearLayout
        android:id="@+id/llTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFF00"
            android:textSize="54sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FF3333"
            android:textSize="54sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#3388FF"
            android:textSize="54sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFF00"
            android:textSize="54sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FF3333"
            android:textSize="54sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#33FF33"
            android:textSize="54sp" />
    </LinearLayout>

    <!-- SPACE SHOOTER Subtitle -->
    <LinearLayout
        android:id="@+id/llSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/llTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPACE "
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFF00"
            android:textSize="14sp" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHOOTER"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FF3333"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- HI-SCORE Block -->
    <LinearLayout
        android:id="@+id/llScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toBottomOf="@id/llSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HI-SCORE"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FF3333"
            android:textSize="20sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NULL"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Middle Ships Placeholder -->
    <LinearLayout
        android:id="@+id/llShips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="72dp"
        app:layout_constraintTop_toBottomOf="@id/llScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Actual Ship Drawables -->
        <ImageView
            android:id="@+id/ivShipWhite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ship_white"
            android:scaleType="fitCenter"
            android:scaleX="1.6"
            android:scaleY="1.6"
            android:contentDescription="White Ship" />

        <ImageView
            android:id="@+id/ivShipRed"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:src="@drawable/ship_red"
            android:scaleType="fitCenter"
            android:contentDescription="Red Ship" />
    </LinearLayout>

    <!-- PRESS TO START Text -->
    <TextView
        android:id="@+id/tvPressStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRESS TO START"
        android:fontFamily="@font/press_start_2p"
        android:textColor="#FFFF00"
        android:textSize="20sp"
        android:layout_marginBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
