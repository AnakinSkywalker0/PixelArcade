<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ttt_bg"
    tools:context=".TicTacToeLauncherActivity">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnTttBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_ttt_btn_unselected"
        android:src="@drawable/ic_retro_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Go Back"
        android:elevation="4dp"/>

    <!-- Title Box -->
    <FrameLayout
        android:id="@+id/boxTttTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_ttt_board"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnTttBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="⚔️  🛡️"
                android:textSize="32sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="SWORDS &amp;\nSHIELDS"
                android:textColor="@color/ttt_title_color"
                android:textSize="20sp"
                android:gravity="center"
                android:lineSpacingExtra="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/press_start_2p"
                android:text="Tic Tac Toe"
                android:textColor="@color/ttt_subtitle_color"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Difficulty Selector -->
    <LinearLayout
        android:id="@+id/boxDifficultySelector"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_ttt_board"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/boxTttTitleContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/press_start_2p"
            android:text="SELECT DIFFICULTY"
            android:textColor="@color/ttt_title_color"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDiffEasy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_ttt_btn_unselected"
                android:fontFamily="@font/press_start_2p"
                android:text="EASY"
                android:textColor="@color/ttt_title_color"
                android:textSize="11sp"
                android:paddingBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDiffMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_ttt_btn_selected"
                android:fontFamily="@font/press_start_2p"
                android:text="MED"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:paddingBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDiffHard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ttt_btn_unselected"
                android:fontFamily="@font/press_start_2p"
                android:text="HARD"
                android:textColor="@color/ttt_title_color"
                android:textSize="11sp"
                android:paddingBottom="10dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Start Game Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTttStartGame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_ttt_btn_start"
        android:fontFamily="@font/press_start_2p"
        android:text="START GAME"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:paddingVertical="16dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/boxDifficultySelector" />

    <!-- Settings Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTttSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_ttt_btn_settings"
        android:fontFamily="@font/press_start_2p"
        android:text="SETTINGS"
        android:textColor="@color/ttt_subtitle_color"
        android:textSize="16sp"
        android:paddingVertical="14dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnTttStartGame" />

    <!-- "How to Play" Overlay -->
    <FrameLayout
        android:id="@+id/overlayTttHowToPlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC1A1B2E"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_ttt_dialog"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:fontFamily="@font/press_start_2p"
                android:text="HOW TO\nPLAY"
                android:textColor="@color/ttt_title_color"
                android:textSize="24sp"
                android:lineSpacingExtra="8dp" />

            <!-- Instruction Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_ttt_board"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/press_start_2p"
                    android:text="TAP AN EMPTY CELL TO PLACE YOUR ⚔️ SWORD."
                    android:textColor="@color/ttt_title_color"
                    android:lineSpacingExtra="12dp"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/press_start_2p"
                    android:text="GET 3 IN A ROW — HORIZONTAL, VERTICAL, OR DIAGONAL — TO WIN!"
                    android:textColor="@color/ttt_title_color"
                    android:lineSpacingExtra="12dp"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:fontFamily="@font/press_start_2p"
                    android:text="DEFEAT THE 🛡️ CPU!"
                    android:textColor="@color/ttt_shield_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTttPlayNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingVertical="18dp"
                android:background="@drawable/bg_ttt_btn_selected"
                android:fontFamily="@font/press_start_2p"
                android:text="PLAY NOW"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnTttCancelTutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:fontFamily="@font/press_start_2p"
                android:text="BACK"
                android:textColor="@color/ttt_subtitle_color"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
