<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Top Bar -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_retro_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#5F564D" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/press_start_2p"
            android:gravity="center"
            android:text="EDIT PIXEL"
            android:textColor="#1B1C22"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnBack" />

        <!-- Current Avatar Preview -->
        <FrameLayout
            android:id="@+id/avatarBox"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_profile_avatar_frame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

            <TextView
                android:id="@+id/tvCurrentAvatarEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="👾"
                android:textSize="64sp" />
        </FrameLayout>

        <!-- Avatar Selection Title -->
        <TextView
            android:id="@+id/tvAvatarLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/press_start_2p"
            android:text="CHOOSE AVATAR"
            android:textColor="#5F564D"
            android:textSize="8sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatarBox" />

        <!-- Avatar Selection List -->
        <HorizontalScrollView
            android:id="@+id/svAvatars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@+id/tvAvatarLabel">

            <LinearLayout
                android:id="@+id/avatarContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <!-- Avatars will be added programmatically -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Input Section Card -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/svAvatars">

            <!-- Display Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:text="DISPLAY NAME"
                android:textColor="#5F564D"
                android:textSize="8sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_auth_input"
                android:fontFamily="@font/press_start_2p"
                android:hint="PLAYER ONE"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#5F564D"
                android:textColorHint="#9A9086"
                android:textSize="12sp" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/press_start_2p"
                android:text="TAGLINE"
                android:textColor="#5F564D"
                android:textSize="8sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etTagline"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_auth_input"
                android:fontFamily="@font/press_start_2p"
                android:hint="ARCADE WARRIOR"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="#5F564D"
                android:textColorHint="#9A9086"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Save Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_btn_brown_3d"
            android:fontFamily="@font/press_start_2p"
            android:paddingBottom="6dp"
            android:text="SAVE CHANGES"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/inputContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
