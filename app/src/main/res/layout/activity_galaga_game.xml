<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    tools:context=".GalagaGameActivity">



    <!-- Game Engine Canvas -->
    <com.example.pixelarcade.GalagaGameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE"
                android:textColor="#FF3333"
                android:fontFamily="@font/press_start_2p"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00000"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/press_start_2p"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HI-SCORE"
                android:textColor="#FF3333"
                android:fontFamily="@font/press_start_2p"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/tvHiScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00000"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/press_start_2p"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAVE"
                android:textColor="#FF3333"
                android:fontFamily="@font/press_start_2p"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/tvWave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01"
                android:textColor="#FFFF00"
                android:fontFamily="@font/press_start_2p"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVES"
            android:textColor="#777777"
            android:fontFamily="@font/press_start_2p"
            android:textSize="10sp"
            android:layout_marginEnd="16dp"/>

        <!-- Life Icons — small Galaga ships -->
        <ImageView android:id="@+id/life1"
            android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ship_white"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"/>
        <ImageView android:id="@+id/life2"
            android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ship_white"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"/>
        <ImageView android:id="@+id/life3"
            android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ship_white"
            android:scaleType="fitCenter"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvBottomWave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAVE 01"
            android:textColor="#FFFF00"
            android:fontFamily="@font/press_start_2p"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Wave Cleared Overlay (Hidden by Default) -->
    <LinearLayout
        android:id="@+id/waveClearedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvClearedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAVE"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#555555"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvOverlayClearedWave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#00FF7F"
            android:textSize="80sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLEARED!"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:layout_marginBottom="32dp"/>

        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/tvNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXT WAVE"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvOverlayNextWave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFF00"
            android:textSize="64sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvBegins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEGINS"
            android:fontFamily="@font/press_start_2p"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
